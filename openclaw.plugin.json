{
	"id": "cliproxyapi",
	"name": "CLIProxyAPI",
	"version": "0.1.6",
	"providers": ["cliproxyapi"],
	"contracts": {
		"imageGenerationProviders": ["cliproxyapi"]
	},
	"imageGenerationProviderMetadata": {
		"cliproxyapi": {
			"authProviders": ["cliproxyapi"]
		}
	},
	"setup": {
		"providers": [{ "id": "cliproxyapi", "envVars": ["CLIPROXYAPI_API_KEY", "CPA_API_KEY"] }]
	},
	"providerCatalogEntry": "./dist/provider-discovery.js",
	"providerAuthChoices": [
		{
			"provider": "cliproxyapi",
			"method": "api-key",
			"choiceId": "cliproxyapi-api-key",
			"choiceLabel": "CLIProxyAPI",
			"groupId": "cliproxyapi",
			"groupLabel": "CLIProxyAPI"
		}
	],
	"configSchema": {
		"type": "object",
		"properties": {
			"refreshIntervalSeconds": {
				"type": "integer",
				"default": 1800,
				"anyOf": [{ "const": 0 }, { "minimum": 30, "maximum": 86400 }],
				"description": "Background model refresh interval in seconds; 0 to disable, defaults to 1800."
			}
		},
		"additionalProperties": false
	}
}
