{
	"id": "cliproxyapi",
	"name": "CLIProxyAPI",
	"version": "0.1.4",
	"providers": ["cliproxyapi"],
	"contracts": {
		"imageGenerationProviders": ["cliproxyapi"]
	},
	"imageGenerationProviderMetadata": {
		"cliproxyapi": {
			"aliases": ["cpa"],
			"authProviders": ["cliproxyapi", "cpa"]
		}
	},
	"setup": {
		"providers": [
			{ "id": "cliproxyapi", "envVars": ["CLIPROXYAPI_API_KEY", "CPA_API_KEY"] },
			{ "id": "cpa", "envVars": ["CLIPROXYAPI_API_KEY", "CPA_API_KEY"] }
		]
	},
	"providerCatalogEntry": "./dist/provider-discovery.js",
	"providerAuthAliases": { "cpa": "cliproxyapi" },
	"modelCatalog": {
		"aliases": {
			"cpa": {
				"provider": "cliproxyapi"
			}
		}
	},
	"providerAuthChoices": [
		{
			"provider": "cliproxyapi",
			"method": "api-key",
			"choiceId": "cliproxyapi-api-key",
			"choiceLabel": "CLIProxyAPI",
			"groupId": "cliproxyapi",
			"groupLabel": "CLIProxyAPI"
		}
	],
	"configSchema": {
		"type": "object",
		"properties": {
			"refreshIntervalSeconds": {
				"type": "integer",
				"default": 1800,
				"anyOf": [{ "const": 0 }, { "minimum": 30, "maximum": 86400 }],
				"description": "Background model refresh interval in seconds; 0 to disable, defaults to 1800."
			}
		},
		"additionalProperties": false
	}
}
